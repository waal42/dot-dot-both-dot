---
// src/pages/dnes/admin.astro
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import RedirectManager from "../../components/wedding-day/RedirectManager.astro";
import { getEntry } from "astro:content";

const wedding = await getEntry("wedding", "info");
const metaTitle = `Správa Dne D | ${wedding?.data.metaTitle || "Hanka & Filip"}`;
---

<Layout title={metaTitle} showFooter={false}>
  <Header />

  <div class="mx-auto max-w-xl px-4 py-8">
    <!-- Admin Login Form (Shown when not authenticated) -->
    <div
      id="admin-login-card"
      class="morse-border bg-wedding-light/90 dark:bg-wedding-dark/80 border-wedding-medium/20 animate-fade-in-up rounded-3xl border p-6 shadow-xl md:p-8"
    >
      <div class="mb-6 text-center">
        <h1 class="text-wedding-dark text-2xl font-bold">
          Přihlášení správy Dnu D
        </h1>
        <p class="text-wedding-medium mt-1 text-xs">Vstup pro administrátory</p>
      </div>

      <form id="admin-login-form" class="space-y-4">
        <div>
          <label
            for="admin-user"
            class="text-wedding-dark mb-1 block text-xs font-bold tracking-wider uppercase"
          >
            Uživatelské jméno
          </label>
          <input
            type="text"
            id="admin-user"
            required
            placeholder="uživatelské jméno"
            class="focus-ring-premium border-wedding-medium/30 bg-wedding-light dark:bg-wedding-dark text-wedding-dark w-full rounded-xl border p-3.5 text-sm font-bold"
          />
        </div>

        <div>
          <label
            for="admin-pass"
            class="text-wedding-dark mb-1 block text-xs font-bold tracking-wider uppercase"
          >
            Heslo
          </label>
          <input
            type="password"
            id="admin-pass"
            required
            placeholder="heslo"
            class="focus-ring-premium border-wedding-medium/30 bg-wedding-light dark:bg-wedding-dark text-wedding-dark w-full rounded-xl border p-3.5 text-sm font-bold"
          />
        </div>

        <button
          type="submit"
          class="morse-border text-wedding-light bg-wedding-dark hover:bg-wedding-medium mt-2 inline-flex w-full items-center justify-center gap-2 rounded-xl py-4 text-sm font-bold tracking-wider uppercase shadow-md transition-all active:scale-95"
        >
          Přihlásit se
        </button>
      </form>
    </div>

    <!-- Admin Control Panel (Shown when authenticated) -->
    <div id="admin-panel" class="animate-fade-in-up hidden space-y-6">
      <div
        class="bg-wedding-light/90 dark:bg-wedding-dark/80 border-wedding-medium/20 flex items-center justify-between rounded-2xl border p-5 shadow-sm"
      >
        <div>
          <h1 class="text-wedding-dark text-xl font-bold">Administrace</h1>
          <span class="text-xs font-bold text-emerald-700 dark:text-emerald-400"
            >přihlášen jako admin</span
          >
        </div>
        <button
          id="admin-logout-btn"
          class="rounded-xl bg-rose-500/10 px-4 py-2 text-xs font-bold text-rose-700 transition-colors hover:bg-rose-600 hover:text-white"
        >
          Odhlásit se
        </button>
      </div>

      <!-- Lock Toggle Control -->
      <div
        class="bg-wedding-light/90 dark:bg-wedding-dark/80 border-wedding-medium/20 rounded-2xl border p-5 shadow-sm"
      >
        <h3 class="text-wedding-dark mb-1 text-base font-bold">
          🔐 Stav zámku pro svatebčany
        </h3>
        <p class="text-wedding-medium mb-4 text-xs">
          Automatické odemčení je nastaveno na sobotu 15.8. ve 13:00. Zde můžete
          aplikaci pro všechny ručně odemknout nebo zamknout.
        </p>

        <div class="flex flex-wrap gap-2">
          <button
            id="lock-auto-btn"
            class="lock-btn bg-wedding-dark/10 text-wedding-dark border-wedding-medium/30 flex-1 rounded-xl border px-3 py-2.5 text-xs font-bold transition-all"
          >
            ⏰ Automaticky (15.8. 13:00)
          </button>
          <button
            id="lock-unlock-btn"
            class="lock-btn flex-1 rounded-xl bg-emerald-600 px-3 py-2.5 text-xs font-bold text-white shadow-2xs transition-all"
          >
            🔓 Odemknout všem
          </button>
          <button
            id="lock-lock-btn"
            class="lock-btn flex-1 rounded-xl bg-rose-600 px-3 py-2.5 text-xs font-bold text-white shadow-2xs transition-all"
          >
            🔒 Zamknout aplikaci
          </button>
        </div>
      </div>

      <!-- Live Announcement Poster -->
      <div
        class="bg-wedding-light/90 dark:bg-wedding-dark/80 border-wedding-medium/20 rounded-2xl border p-5 shadow-sm"
      >
        <h3 class="text-wedding-dark mb-1 text-base font-bold">
          📢 Publikovat bleskovou zprávu hostům
        </h3>
        <p class="text-wedding-medium mb-3 text-xs">
          Oznámení se okamžitě zobrazí na všech telefonů svatebčanů v horním
          banneru.
        </p>

        <form id="post-announcement-form" class="space-y-3">
          <textarea
            id="announcement-input"
            required
            rows="2"
            placeholder="Napište krátké oznámení (např. Krájení dortu začíná za 5 minut!)..."
            class="focus-ring-premium border-wedding-medium/30 bg-wedding-light dark:bg-wedding-dark text-wedding-dark w-full rounded-xl border p-3 text-xs font-medium"
          ></textarea>

          <button
            type="submit"
            class="inline-flex items-center gap-1.5 rounded-xl bg-amber-600 px-5 py-3 text-xs font-bold tracking-wider text-white uppercase shadow-md transition-all hover:bg-amber-700 active:scale-95"
          >
            <span>📢</span> Zveřejnit všem hostům
          </button>
        </form>

        <div class="border-wedding-medium/15 mt-5 border-t pt-4">
          <h4
            class="text-wedding-dark mb-2 text-xs font-bold tracking-wider uppercase"
          >
            Aktivní zprávy:
          </h4>
          <div id="announcements-list" class="space-y-2 text-xs">
            <!-- List items loaded dynamically -->
          </div>
        </div>
      </div>

      <!-- Program & Activities Manager -->
      <div
        class="bg-wedding-light/90 dark:bg-wedding-dark/80 border-wedding-medium/20 rounded-2xl border p-5 shadow-sm"
      >
        <h3 class="text-wedding-dark mb-1 text-base font-bold">
          🎯 Správa svatebního programu & aktivit
        </h3>
        <div class="mb-3 flex items-center justify-between">
          <p class="text-wedding-medium text-xs">
            Vkládejte informace o tom, co a kde se dá na svatbě dělat (např.
            Fotokoutek, Prskavky, Kvíz, Vodní dýmky). Zobrazí se v hlavním
            programu.
          </p>
          <span id="prog-form-badge" class="shrink-0 text-emerald-800 dark:text-emerald-300 font-extrabold text-[10px] uppercase bg-emerald-500/10 px-2 py-0.5 rounded">
            Nová položka
          </span>
        </div>

        <form
          id="post-program-form"
          class="bg-wedding-dark/5 dark:bg-wedding-light/5 border-wedding-medium/15 space-y-3 rounded-xl border p-4 transition-all"
        >
          <input type="hidden" id="prog-edit-id" value="" />

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div>
              <label
                for="prog-time"
                class="text-wedding-dark mb-1 block text-xs font-bold"
                >Čas / Kdy</label
              >
              <input
                type="text"
                id="prog-time"
                placeholder="např. 16:00 nebo Průběžně"
                class="focus-ring-premium border-wedding-medium/30 bg-wedding-light dark:bg-wedding-dark text-wedding-dark w-full rounded-lg border p-2.5 text-xs font-bold"
              />
            </div>
            <div>
              <label
                for="prog-title"
                class="text-wedding-dark mb-1 block text-xs font-bold"
                >Název aktivity *</label
              >
              <input
                type="text"
                id="prog-title"
                required
                placeholder="např. Fotokoutek & Kniha"
                class="focus-ring-premium border-wedding-medium/30 bg-wedding-light dark:bg-wedding-dark text-wedding-dark w-full rounded-lg border p-2.5 text-xs font-bold"
              />
            </div>
            <div>
              <label
                for="prog-location"
                class="text-wedding-dark mb-1 block text-xs font-bold"
                >Kde / Místo</label
              >
              <input
                type="text"
                id="prog-location"
                placeholder="např. Salónek v 1. patře"
                class="focus-ring-premium border-wedding-medium/30 bg-wedding-light dark:bg-wedding-dark text-wedding-dark w-full rounded-lg border p-2.5 text-xs font-semibold"
              />
            </div>
          </div>

          <div>
            <label
              for="prog-description"
              class="text-wedding-dark mb-1 block text-xs font-bold"
              >Popis / Pokyny pro hosty</label
            >
            <input
              type="text"
              id="prog-description"
              placeholder="např. Vyfoťte se a nalepte fotku do knížky přání!"
              class="focus-ring-premium border-wedding-medium/30 bg-wedding-light dark:bg-wedding-dark text-wedding-dark w-full rounded-lg border p-2.5 text-xs font-medium"
            />
          </div>

          <div class="flex items-center gap-2">
            <button
              type="submit"
              id="prog-submit-btn"
              class="inline-flex cursor-pointer items-center gap-1.5 rounded-lg bg-emerald-700 px-4 py-2.5 text-xs font-bold tracking-wider text-white uppercase shadow-sm transition-all hover:bg-emerald-800 active:scale-95"
            >
              <span id="prog-submit-icon">➕</span> <span id="prog-submit-label">Přidat do programu</span>
            </button>
            <button
              type="button"
              id="prog-cancel-btn"
              class="hidden cursor-pointer items-center gap-1 rounded-lg border border-wedding-medium/30 bg-wedding-light dark:bg-wedding-dark px-3 py-2.5 text-xs font-bold text-wedding-medium hover:text-wedding-dark transition-all active:scale-95"
            >
              ✕ Zrušit úpravu
            </button>
          </div>
        </form>

        <div class="border-wedding-medium/15 mt-5 border-t pt-4">
          <h4
            class="text-wedding-dark mb-2 text-xs font-bold tracking-wider uppercase"
          >
            Aktivní položky programu:
          </h4>
          <div id="program-items-list" class="space-y-2 text-xs">
            <!-- Program items loaded dynamically -->
          </div>
        </div>
      </div>

      <!-- Redirects Manager -->
      <RedirectManager />
    </div>
  </div>
</Layout>

<script>
  let adminToken = localStorage.getItem("dnes_admin_token") || "";

  async function checkAdminAuth() {
    const loginCard = document.getElementById("admin-login-card");
    const panel = document.getElementById("admin-panel");

    if (!adminToken) {
      loginCard?.classList.remove("hidden");
      panel?.classList.add("hidden");
      return;
    }

    try {
      const res = await fetch("/svatba/dnes/api/data", {
        headers: { Authorization: `Bearer ${adminToken}` },
      });
      const data = await res.json();

      if (data.is_admin) {
        loginCard?.classList.add("hidden");
        panel?.classList.remove("hidden");
        loadAnnouncementsList(data.announcements || []);
        loadProgramItemsList(data.program_items || []);
      } else {
        localStorage.removeItem("dnes_admin_token");
        adminToken = "";
        loginCard?.classList.remove("hidden");
        panel?.classList.add("hidden");
      }
    } catch (e) {
      loginCard?.classList.remove("hidden");
      panel?.classList.add("hidden");
    }
  }

  function loadAnnouncementsList(list: any[]) {
    const listEl = document.getElementById("announcements-list");
    if (!listEl) return;

    if (list.length === 0) {
      listEl.innerHTML = `<p class="text-wedding-medium italic">Žádná aktivní oznámení.</p>`;
      return;
    }

    listEl.innerHTML = list
      .map(
        (item) => `
      <div class="bg-wedding-dark/5 dark:bg-wedding-light/5 border-wedding-medium/15 flex items-center justify-between rounded-xl border p-3">
        <div>
          <p class="font-bold text-wedding-dark">${item.text}</p>
          <span class="text-[10px] text-wedding-medium font-mono">${item.timestamp ? new Date(item.timestamp).toLocaleTimeString("cs-CZ") : ""}</span>
        </div>
        <button data-id="${item.id}" class="delete-msg-btn bg-rose-500/10 hover:bg-rose-600 hover:text-white text-rose-700 font-bold px-2.5 py-1 rounded-lg text-xs transition-colors">
          🗑️ Smazat
        </button>
      </div>
    `,
      )
      .join("");

    document.querySelectorAll(".delete-msg-btn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const id = (e.currentTarget as HTMLButtonElement).getAttribute(
          "data-id",
        );
        if (id) deleteAnnouncement(id);
      });
    });
  }

  async function deleteAnnouncement(id: string) {
    try {
      const res = await fetch("/svatba/dnes/api/admin/update", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${adminToken}`,
        },
        body: JSON.stringify({ action: "delete_announcement", id }),
      });
      if (res.ok) checkAdminAuth();
    } catch (e) {
      alert("Chyba při mazání zprávy.");
    }
  }

  function loadProgramItemsList(list: any[]) {
    const listEl = document.getElementById("program-items-list");
    if (!listEl) return;

    if (list.length === 0) {
      listEl.innerHTML = `<p class="text-wedding-medium italic">Žádné uživatelské položky v programu.</p>`;
      return;
    }

    listEl.innerHTML = list
      .map(
        (item) => `
      <div class="bg-wedding-dark/5 dark:bg-wedding-light/5 border-wedding-medium/15 flex items-center justify-between rounded-xl border p-3">
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="bg-wedding-dark text-wedding-light font-mono font-bold px-1.5 py-0.5 rounded text-[10px]">${item.time || "Průběžně"}</span>
            <p class="font-bold text-wedding-dark text-xs">${item.title}</p>
          </div>
          ${item.location ? `<p class="text-wedding-medium text-[11px] font-semibold mt-0.5">📍 ${item.location}</p>` : ""}
          ${item.description ? `<p class="text-wedding-medium text-[11px] mt-0.5 leading-relaxed">${item.description}</p>` : ""}
        </div>
        <div class="flex items-center gap-1.5 shrink-0 ml-2">
          <button
            data-id="${item.id}"
            data-time="${item.time || ''}"
            data-title="${encodeURIComponent(item.title || '')}"
            data-location="${encodeURIComponent(item.location || '')}"
            data-description="${encodeURIComponent(item.description || '')}"
            class="edit-prog-btn bg-wedding-dark/10 hover:bg-wedding-dark hover:text-wedding-light text-wedding-dark font-bold px-2.5 py-1 rounded-lg text-xs transition-all cursor-pointer active:scale-95"
            aria-label="Upravit položku ${item.title}"
          >
            ✏️ Upravit
          </button>
          <button
            data-id="${item.id}"
            class="delete-prog-btn bg-rose-500/10 hover:bg-rose-600 hover:text-white text-rose-700 font-bold px-2.5 py-1 rounded-lg text-xs transition-all cursor-pointer active:scale-95"
            aria-label="Smazat položku ${item.title}"
          >
            🗑️ Smazat
          </button>
        </div>
      </div>
    `,
      )
      .join("");

    document.querySelectorAll(".edit-prog-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute("data-id") || "";
        const time = target.getAttribute("data-time") || "";
        const title = decodeURIComponent(target.getAttribute("data-title") || "");
        const location = decodeURIComponent(target.getAttribute("data-location") || "");
        const description = decodeURIComponent(target.getAttribute("data-description") || "");
        startEditProgramItem({ id, time, title, location, description });
      });
    });

    document.querySelectorAll(".delete-prog-btn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const id = (e.currentTarget as HTMLButtonElement).getAttribute(
          "data-id",
        );
        if (id) deleteProgramItem(id);
      });
    });
  }

  function startEditProgramItem(item: { id: string; time: string; title: string; location: string; description: string }) {
    const editIdInput = document.getElementById("prog-edit-id") as HTMLInputElement;
    const timeInput = document.getElementById("prog-time") as HTMLInputElement;
    const titleInput = document.getElementById("prog-title") as HTMLInputElement;
    const locationInput = document.getElementById("prog-location") as HTMLInputElement;
    const descInput = document.getElementById("prog-description") as HTMLInputElement;

    if (editIdInput) editIdInput.value = item.id;
    if (timeInput) timeInput.value = item.time === "Průběžně" ? "" : item.time;
    if (titleInput) titleInput.value = item.title;
    if (locationInput) locationInput.value = item.location;
    if (descInput) descInput.value = item.description;

    const label = document.getElementById("prog-submit-label");
    const icon = document.getElementById("prog-submit-icon");
    const badge = document.getElementById("prog-form-badge");
    const cancelBtn = document.getElementById("prog-cancel-btn");

    if (label) label.textContent = "Uložit změny";
    if (icon) icon.textContent = "💾";
    if (badge) {
      badge.textContent = "Úprava položky";
      badge.className = "shrink-0 text-amber-800 dark:text-amber-300 font-extrabold text-[10px] uppercase bg-amber-500/10 px-2 py-0.5 rounded";
    }
    cancelBtn?.classList.remove("hidden");

    document.getElementById("post-program-form")?.scrollIntoView({ behavior: "smooth", block: "center" });
    titleInput?.focus();
  }

  function resetProgramForm() {
    const editIdInput = document.getElementById("prog-edit-id") as HTMLInputElement;
    const timeInput = document.getElementById("prog-time") as HTMLInputElement;
    const titleInput = document.getElementById("prog-title") as HTMLInputElement;
    const locationInput = document.getElementById("prog-location") as HTMLInputElement;
    const descInput = document.getElementById("prog-description") as HTMLInputElement;

    if (editIdInput) editIdInput.value = "";
    if (timeInput) timeInput.value = "";
    if (titleInput) titleInput.value = "";
    if (locationInput) locationInput.value = "";
    if (descInput) descInput.value = "";

    const label = document.getElementById("prog-submit-label");
    const icon = document.getElementById("prog-submit-icon");
    const badge = document.getElementById("prog-form-badge");
    const cancelBtn = document.getElementById("prog-cancel-btn");

    if (label) label.textContent = "Přidat do programu";
    if (icon) icon.textContent = "➕";
    if (badge) {
      badge.textContent = "Nová položka";
      badge.className = "shrink-0 text-emerald-800 dark:text-emerald-300 font-extrabold text-[10px] uppercase bg-emerald-500/10 px-2 py-0.5 rounded";
    }
    cancelBtn?.classList.add("hidden");
  }

  async function deleteProgramItem(id: string) {
    try {
      const res = await fetch("/svatba/dnes/api/admin/update", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${adminToken}`,
        },
        body: JSON.stringify({ action: "delete_program_item", id }),
      });
      if (res.ok) checkAdminAuth();
    } catch (e) {
      alert("Chyba při mazání položky programu.");
    }
  }

  async function setLockState(override: boolean | null) {
    try {
      const res = await fetch("/svatba/dnes/api/admin/update", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${adminToken}`,
        },
        body: JSON.stringify({ action: "toggle_lock", override }),
      });
      if (res.ok) {
        alert("Stav zámku byl aktualizován.");
        checkAdminAuth();
      }
    } catch (e) {
      alert("Chyba při změně zámku.");
    }
  }

  function initAdmin() {
    checkAdminAuth();

    // Login Form Submit
    document
      .getElementById("admin-login-form")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const user = (document.getElementById("admin-user") as HTMLInputElement)
          .value;
        const pass = (document.getElementById("admin-pass") as HTMLInputElement)
          .value;

        try {
          const res = await fetch("/svatba/dnes/api/admin/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ username: user, password: pass }),
          });

          const rawText = await res.text();
          let data: any = {};
          try {
            data = rawText ? JSON.parse(rawText) : {};
          } catch (e) {
            alert(
              `Server vrátil ne-JSON odpověď (HTTP ${res.status}): ${rawText.slice(0, 150)}`,
            );
            return;
          }

          if (res.ok && data.token) {
            adminToken = data.token;
            localStorage.setItem("dnes_admin_token", data.token);
            checkAdminAuth();
          } else {
            alert(data.error || "Neplatné přihlašovací údaje.");
          }
        } catch (err) {
          alert("Chyba spojení s serverem (" + err + ").");
        }
      });

    // Logout Button
    document
      .getElementById("admin-logout-btn")
      ?.addEventListener("click", () => {
        localStorage.removeItem("dnes_admin_token");
        adminToken = "";
        checkAdminAuth();
      });

    // Post Announcement Form Submit
    document
      .getElementById("post-announcement-form")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const input = document.getElementById(
          "announcement-input",
        ) as HTMLTextAreaElement;
        if (!input.value.trim()) return;

        try {
          const res = await fetch("/svatba/dnes/api/admin/update", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${adminToken}`,
            },
            body: JSON.stringify({
              action: "add_announcement",
              text: input.value.trim(),
            }),
          });

          if (res.ok) {
            input.value = "";
            checkAdminAuth();
          } else {
            alert("Chyba při publikování zprávy.");
          }
        } catch (err) {
          alert("Chyba při komunikaci s API.");
        }
      });

    // Post Program Item Form Submit (Add or Edit)
    document
      .getElementById("post-program-form")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const editId = (
          document.getElementById("prog-edit-id") as HTMLInputElement
        ).value.trim();
        const timeInput = (
          document.getElementById("prog-time") as HTMLInputElement
        ).value;
        const titleInput = (
          document.getElementById("prog-title") as HTMLInputElement
        ).value;
        const locationInput = (
          document.getElementById("prog-location") as HTMLInputElement
        ).value;
        const descInput = (
          document.getElementById("prog-description") as HTMLInputElement
        ).value;

        if (!titleInput.trim()) return;

        const action = editId ? "edit_program_item" : "add_program_item";
        const payload: Record<string, string> = {
          action,
          time: timeInput.trim(),
          title: titleInput.trim(),
          location: locationInput.trim(),
          description: descInput.trim(),
        };
        if (editId) payload.id = editId;

        try {
          const res = await fetch("/svatba/dnes/api/admin/update", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${adminToken}`,
            },
            body: JSON.stringify(payload),
          });

          if (res.ok) {
            resetProgramForm();
            checkAdminAuth();
          } else {
            alert(editId ? "Chyba při úpravě položky programu." : "Chyba při přidávání položky programu.");
          }
        } catch (err) {
          alert("Chyba při komunikaci s API.");
        }
      });

    // Cancel Edit Button
    document
      .getElementById("prog-cancel-btn")
      ?.addEventListener("click", resetProgramForm);

    // Lock Buttons
    document
      .getElementById("lock-auto-btn")
      ?.addEventListener("click", () => setLockState(null));
    document
      .getElementById("lock-unlock-btn")
      ?.addEventListener("click", () => setLockState(false));
    document
      .getElementById("lock-lock-btn")
      ?.addEventListener("click", () => setLockState(true));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAdmin);
  } else {
    initAdmin();
  }
</script>
