---
// src/pages/dnes/index.astro
import Layout from "../../layouts/Layout.astro";
import LockedTeaser from "../../components/wedding-day/LockedTeaser.astro";
import LiveBanner from "../../components/wedding-day/LiveBanner.astro";
import ScheduleTab from "../../components/wedding-day/ScheduleTab.astro";
import PhotoTab from "../../components/wedding-day/PhotoTab.astro";
import GuestbookTab from "../../components/wedding-day/GuestbookTab.astro";
import InfoTab from "../../components/wedding-day/InfoTab.astro";
import { getEntry } from "astro:content";

const wedding = await getEntry("wedding", "info");
const metaTitle = `Živý průvodce dnem D | ${wedding?.data.metaTitle || "Hanka & Filip"}`;
---

<Layout title={metaTitle} showFooter={false}>
  <!-- Compact Standalone App Header -->
  <header
    class="bg-wedding-light/95 border-wedding-medium/20 sticky top-0 z-40 border-b px-4 py-3 shadow-xs backdrop-blur-md"
  >
    <div class="mx-auto flex max-w-xl items-center justify-between">
      <a
        href={import.meta.env.BASE_URL}
        class="text-wedding-medium hover:text-wedding-dark inline-flex items-center gap-1.5 text-xs font-bold transition-colors"
      >
        <span>←</span> Hlavní web
      </a>
      <div class="text-center">
        <span class="text-wedding-dark text-sm font-extrabold tracking-tight"
          >Svatbinfo</span
        >
      </div>
      <div class="flex items-center gap-3">
        <span class="text-wedding-medium hidden text-xs font-semibold sm:inline"
          >Hanka & Filip</span
        >
        <button
          id="theme-toggle"
          class="text-wedding-medium hover:text-wedding-dark hover:bg-wedding-medium/10 flex h-8 w-8 cursor-pointer items-center justify-center rounded-full transition-colors"
          aria-label="Přepnout tmavý/světlý režim"
          title="Přepnout tmavý/světlý režim"
        >
          <span class="dark:hidden">🌙</span>
          <span class="hidden dark:inline">☀️</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Locked Teaser (shown when app is time-locked for non-admins) -->
  <div id="dnes-locked-view" class="">
    <LockedTeaser />
  </div>

  <!-- Unlocked Full Mobile App -->
  <div id="dnes-app-view" class="mx-auto hidden max-w-xl px-4 pt-4 pb-28">
    <!-- Live Announcement Banner -->
    <LiveBanner />

    <!-- Tab Contents -->
    <main id="dnes-tab-contents">
      <section id="tab-schedule" class="tab-pane animate-fade-in-up" role="tabpanel" aria-labelledby="tab-schedule-btn">
        <ScheduleTab />
      </section>

      <section id="tab-photos" class="tab-pane animate-fade-in-up hidden" role="tabpanel" aria-labelledby="tab-photos-btn">
        <PhotoTab />
      </section>

      <section id="tab-guestbook" class="tab-pane animate-fade-in-up hidden" role="tabpanel" aria-labelledby="tab-guestbook-btn">
        <GuestbookTab />
      </section>

      <section id="tab-info" class="tab-pane animate-fade-in-up hidden" role="tabpanel" aria-labelledby="tab-info-btn">
        <InfoTab />
      </section>
    </main>

    <!-- Mobile Bottom Navigation Bar (Fixed at bottom) -->
    <nav
      role="tablist"
      aria-label="Navigace Dne D"
      class="bg-wedding-light/95 border-wedding-medium/20 fixed bottom-0 left-0 z-40 w-full border-t pb-safe backdrop-blur-md"
    >
      <div class="mx-auto flex max-w-xl justify-around px-2 py-2">
        <button
          id="tab-schedule-btn"
          role="tab"
          aria-selected="true"
          aria-controls="tab-schedule"
          data-target="tab-schedule"
          class="nav-tab-btn text-wedding-dark flex flex-1 scale-105 cursor-pointer flex-col items-center gap-1 py-1 text-center font-extrabold transition-all"
        >
          <span class="text-lg">🕒</span>
          <span class="text-[11px]">Program</span>
        </button>

        <button
          id="tab-photos-btn"
          role="tab"
          aria-selected="false"
          aria-controls="tab-photos"
          data-target="tab-photos"
          class="nav-tab-btn text-wedding-medium flex flex-1 cursor-pointer flex-col items-center gap-1 py-1 text-center transition-all"
        >
          <span class="text-lg">📸</span>
          <span class="text-[11px]">Fotky</span>
        </button>

        <button
          id="tab-guestbook-btn"
          role="tab"
          aria-selected="false"
          aria-controls="tab-guestbook"
          data-target="tab-guestbook"
          class="nav-tab-btn text-wedding-medium flex flex-1 cursor-pointer flex-col items-center gap-1 py-1 text-center transition-all"
        >
          <span class="text-lg">✍️</span>
          <span class="text-[11px]">Vzkazy</span>
        </button>

        <button
          id="tab-info-btn"
          role="tab"
          aria-selected="false"
          aria-controls="tab-info"
          data-target="tab-info"
          class="nav-tab-btn text-wedding-medium flex flex-1 cursor-pointer flex-col items-center gap-1 py-1 text-center transition-all"
        >
          <span class="text-lg">ℹ️</span>
          <span class="text-[11px]">Info</span>
        </button>
      </div>
    </nav>
  </div>
</Layout>

<script>
  async function checkAppLock() {
    const adminToken = localStorage.getItem("dnes_admin_token");
    const lockedView = document.getElementById("dnes-locked-view");
    const appView = document.getElementById("dnes-app-view");

    // Client-side date + time check for 15. August 2026 13:00 CEST
    const unlockTime = new Date("2026-08-15T13:00:00+02:00").getTime();
    const now = new Date().getTime();
    let isLocked = now < unlockTime;

    try {
      const res = await fetch("/svatba/dnes/api/data", {
        headers: adminToken ? { Authorization: `Bearer ${adminToken}` } : {},
      });
      if (res.ok) {
        const data = await res.json();
        if (data.is_admin) {
          isLocked = false;
        } else if (data.is_locked !== undefined) {
          isLocked = data.is_locked;
        }
      }
    } catch (e) {
      console.warn("API Lock check offline, using static date/time lock state");
    }

    if (isLocked) {
      lockedView?.classList.remove("hidden");
      appView?.classList.add("hidden");
    } else {
      lockedView?.classList.add("hidden");
      appView?.classList.remove("hidden");
    }
  }

  function initTabs() {
    const tabBtns = document.querySelectorAll(".nav-tab-btn");
    const tabPanes = document.querySelectorAll(".tab-pane");

    function switchTab(targetId: string) {
      tabPanes.forEach((pane) => {
        if (pane.id === targetId) {
          pane.classList.remove("hidden");
        } else {
          pane.classList.add("hidden");
        }
      });

      tabBtns.forEach((btn) => {
        const isTarget = btn.getAttribute("data-target") === targetId;
        if (isTarget) {
          btn.classList.remove("text-wedding-medium");
          btn.classList.add("text-wedding-dark", "scale-105", "font-extrabold");
        } else {
          btn.classList.remove(
            "text-wedding-dark",
            "scale-105",
            "font-extrabold",
          );
          btn.classList.add("text-wedding-medium");
        }
      });

      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.getAttribute("data-target");
        if (target) switchTab(target);
      });
    });

    // Handle hash links (e.g. #vzkaznik)
    if (window.location.hash) {
      const hash = window.location.hash.substring(1);
      if (hash === "vzkaznik") switchTab("tab-guestbook");
      if (hash === "fotky") switchTab("tab-photos");
      if (hash === "kontakty") switchTab("tab-info");
    }
  }

  function initThemeToggle() {
    const themeBtn = document.getElementById("theme-toggle");
    const toggleTheme = () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    };
    (window as any).toggleTheme = toggleTheme;
    themeBtn?.addEventListener("click", toggleTheme);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      initThemeToggle();
      checkAppLock();
      initTabs();
    });
  } else {
    initThemeToggle();
    checkAppLock();
    initTabs();
  }
</script>
