---
// src/components/wedding-day/LockedTeaser.astro
interface Props {
  unlockTime?: string;
}

const { unlockTime = "2026-08-15T13:00:00+02:00" } = Astro.props;
---

<div
  class="flex min-h-[80vh] flex-col items-center justify-center px-4 py-12 text-center"
>
  <div
    class="morse-border bg-wedding-light dark:bg-wedding-dark/95 border-wedding-dark/30 animate-fade-in-up max-w-lg rounded-3xl p-4 sm:p-8 md:p-12 shadow-2xl"
  >
    <h1
      class="text-wedding-dark mb-3 text-3xl font-extrabold tracking-tight md:text-4xl"
    >
      Svatební Den D
    </h1>
    <p
      class="text-wedding-medium mb-6 text-sm font-semibold tracking-widest uppercase"
    >
      Hanka & Filip | 15. srpna 2026
    </p>

    <div
      class="bg-wedding-dark/5 dark:bg-wedding-light/5 border-wedding-medium/20 mb-8 rounded-2xl border p-6"
    >
      <p class="text-wedding-dark mb-4 text-base leading-relaxed font-semibold">
        Aplikace pro svatební Den D se otevře v sobotu 15. srpna ve 13:00!
      </p>
      <p class="text-wedding-medium text-xs">
        Najdete zde živé oznamy, harmonogram, odjezdy MHD, fotoalbum a svatební
        vzkazník.
      </p>
    </div>

    <!-- Countdown Timer -->
    <div id="countdown-box" class="mb-2 grid grid-cols-4 gap-1.5 sm:gap-3">
      <div
        class="bg-wedding-dark text-wedding-light min-w-0 w-full rounded-xl p-2.5 sm:p-3 shadow-sm"
      >
        <span
          id="cd-days"
          class="block font-mono text-xl font-extrabold sm:text-2xl md:text-3xl">--</span
        >
        <span
          class="block text-[9px] sm:text-[10px] font-bold tracking-wider uppercase opacity-80"
          >dní</span
        >
      </div>
      <div
        class="bg-wedding-dark text-wedding-light min-w-0 w-full rounded-xl p-2.5 sm:p-3 shadow-sm"
      >
        <span
          id="cd-hours"
          class="block font-mono text-xl font-extrabold sm:text-2xl md:text-3xl">--</span
        >
        <span
          class="block text-[9px] sm:text-[10px] font-bold tracking-wider uppercase opacity-80"
          >hodin</span
        >
      </div>
      <div
        class="bg-wedding-dark text-wedding-light min-w-0 w-full rounded-xl p-2.5 sm:p-3 shadow-sm"
      >
        <span
          id="cd-mins"
          class="block font-mono text-xl font-extrabold sm:text-2xl md:text-3xl">--</span
        >
        <span
          class="block text-[9px] sm:text-[10px] font-bold tracking-wider uppercase opacity-80"
          >minut</span
        >
      </div>
      <div
        class="bg-wedding-dark text-wedding-light min-w-0 w-full rounded-xl p-2.5 sm:p-3 shadow-sm"
      >
        <span
          id="cd-secs"
          class="block font-mono text-xl font-extrabold sm:text-2xl md:text-3xl">--</span
        >
        <span
          class="block text-[9px] sm:text-[10px] font-bold tracking-wider uppercase opacity-80"
          >sekund</span
        >
      </div>
    </div>
  </div>
</div>

<script define:vars={{ unlockTime }}>
  function updateCountdown() {
    const targetDate = new Date(unlockTime).getTime();
    const now = new Date().getTime();
    const diff = targetDate - now;

    if (diff <= 0) {
      window.location.reload();
      return;
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const secs = Math.floor((diff % (1000 * 60)) / 1000);

    document.getElementById("cd-days").textContent = String(days);
    document.getElementById("cd-hours").textContent = String(hours).padStart(
      2,
      "0",
    );
    document.getElementById("cd-mins").textContent = String(mins).padStart(
      2,
      "0",
    );
    document.getElementById("cd-secs").textContent = String(secs).padStart(
      2,
      "0",
    );
  }

  setInterval(updateCountdown, 1000);
  updateCountdown();
</script>
