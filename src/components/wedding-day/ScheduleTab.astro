---
// src/components/wedding-day/ScheduleTab.astro
import { getEntry } from "astro:content";

const wedding = await getEntry("wedding", "info");
const staticScheduleItems = wedding?.data.schedule.items || [];
---

<div class="space-y-6">
  <!-- Program & Activities Section -->
  <div
    class="morse-border bg-wedding-light/90 dark:bg-wedding-dark/80 border-wedding-medium/20 rounded-2xl border p-5 shadow-sm"
  >
    <div class="mb-5 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div
          class="bg-wedding-dark/10 dark:bg-wedding-light/10 text-wedding-dark flex h-10 w-10 items-center justify-center rounded-xl text-xl font-bold"
        >
          🎯
        </div>
        <div>
          <h2 class="text-wedding-dark flex items-center gap-2.5 text-xl font-bold tracking-tight">
            <span class="morse-decoder text-wedding-medium text-base tracking-tighter opacity-30 hover:opacity-100 transition-opacity" data-decoded="P">·——·</span>
            <span>Program</span>
            <span class="morse-decoder text-wedding-medium text-base tracking-tighter opacity-30 hover:opacity-100 transition-opacity" data-decoded="R">·—·</span>
          </h2>
          <p class="text-wedding-medium text-xs mt-0.5">
            Aktivity, stanoviště a zábava
          </p>
        </div>
      </div>
    </div>

    <!-- Container for dynamic admin-added program activities -->
    <div id="dynamic-program-feed" class="mb-4 space-y-3">
      <div class="text-wedding-medium py-4 text-center text-xs italic">
        Načítám program...
      </div>
    </div>

    <!-- Collapsible Static Schedule Baseline -->
    <div class="border-wedding-medium/15 mt-6 border-t pt-4">
      <button
        id="toggle-static-schedule-btn"
        type="button"
        class="flex w-full cursor-pointer items-center justify-between text-left transition-all duration-200 hover:opacity-80 active:scale-[0.99]"
      >
        <div class="flex items-center gap-2">
          <span class="text-xs">🕒</span>
          <span class="text-wedding-dark text-xs font-bold"
            >Zobrazit orientační harmonogram dne</span
          >
        </div>
        <span
          id="static-schedule-chevron"
          class="text-wedding-medium text-[11px] font-bold"
        >
          Rozbalit ▾
        </span>
      </button>

      <div id="static-schedule-content" class="mt-3 hidden space-y-2">
        {
          staticScheduleItems.map((item) => (
            <div class="bg-wedding-light/90 dark:bg-wedding-dark/80 border-wedding-medium/10 flex items-start gap-3 rounded-xl border p-3 text-xs">
              <span class="bg-wedding-dark text-wedding-light shrink-0 rounded-lg px-2.5 py-1 font-mono text-[11px] font-extrabold">
                {item.time}
              </span>
              <div>
                <h4 class="text-wedding-dark font-bold">{item.title}</h4>
                {item.description && (
                  <p class="text-wedding-medium mt-0.5 text-[11px] leading-relaxed">
                    {item.description}
                  </p>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  async function loadProgramFeed() {
    const feedContainer = document.getElementById("dynamic-program-feed");
    if (!feedContainer) return;

    try {
      const res = await fetch("/svatba/dnes/api/data");
      if (!res.ok) return;
      const data = await res.json();
      const items = data.program_items || [];

      if (items.length === 0) {
        feedContainer.innerHTML = `
          <div class="bg-wedding-dark/5 dark:bg-wedding-light/5 rounded-2xl p-5 text-center">
            <span class="text-2xl block mb-2">🎈</span>
            <p class="text-wedding-dark font-bold text-sm mb-1">Zatím tu nic není.</p>
            <p class="text-wedding-medium text-xs leading-relaxed max-w-sm mx-auto">
            Ale my to sem postupně všechno přidáme!
            </p>
          </div>
        `;
        return;
      }

      feedContainer.innerHTML = items
        .map((item: any) => {
          return `
          <div class="bg-wedding-light dark:bg-wedding-dark/90 border-wedding-medium/20 rounded-2xl border p-4 shadow-2xs hover:shadow-xs transition-all">
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-start gap-3">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-wedding-dark/10 dark:bg-wedding-light/10 text-base font-bold">
                  ${item.icon || "📌"}
                </span>
                <div>
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="bg-wedding-dark text-wedding-light font-mono font-extrabold text-[11px] px-2.5 py-0.5 rounded-lg">
                      ${item.time || "Průběžně"}
                    </span>
                    <h3 class="text-wedding-dark font-extrabold text-sm">${item.title}</h3>
                  </div>
                  ${
                    item.location
                      ? `
                    <div class="mt-1 inline-flex items-center gap-1 text-[11px] font-bold text-emerald-800 dark:text-emerald-300 bg-emerald-500/10 px-2 py-0.5 rounded-md">
                      📍 ${item.location}
                    </div>
                  `
                      : ""
                  }
                  ${
                    item.description
                      ? `
                    <p class="text-wedding-medium mt-2 text-xs leading-relaxed font-medium">${item.description}</p>
                  `
                      : ""
                  }
                </div>
              </div>
            </div>
          </div>
        `;
        })
        .join("");
    } catch (e) {
      console.warn("Error loading program items feed:", e);
    }
  }

  function initScheduleTab() {
    // Toggle static schedule
    const toggleBtn = document.getElementById("toggle-static-schedule-btn");
    const content = document.getElementById("static-schedule-content");
    const chevron = document.getElementById("static-schedule-chevron");

    toggleBtn?.addEventListener("click", () => {
      const isHidden = content?.classList.contains("hidden");
      if (isHidden) {
        content?.classList.remove("hidden");
        if (chevron) chevron.textContent = "Skrýt ▴";
      } else {
        content?.classList.add("hidden");
        if (chevron) chevron.textContent = "Rozbalit ▾";
      }
    });

    loadProgramFeed();
    setInterval(loadProgramFeed, 30000);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initScheduleTab);
  } else {
    initScheduleTab();
  }
</script>
