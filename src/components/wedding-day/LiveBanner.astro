---
// src/components/wedding-day/LiveBanner.astro
---

<div id="live-announcement-container" class="mb-6 hidden">
  <div class="morse-border bg-amber-500/10 dark:bg-amber-500/20 border-amber-600/40 text-wedding-dark animate-fade-in-up relative rounded-2xl p-4 md:p-5 shadow-md">
    <div class="flex items-start gap-3">
      <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-amber-500 text-white font-extrabold text-sm shadow-sm animate-pulse">
        📢
      </span>
      <div class="flex-1">
        <div class="flex items-center justify-between gap-2">
          <span class="text-amber-800 dark:text-amber-300 font-extrabold text-xs uppercase tracking-wider">
            Aktuální oznam z dnu D
          </span>
          <span id="announcement-time" class="text-wedding-medium font-mono text-[11px]"></span>
        </div>
        <p id="announcement-text" class="text-wedding-dark mt-1 text-sm font-bold leading-relaxed md:text-base"></p>
      </div>
    </div>
  </div>
</div>

<script>
  let lastSeenId = "";

  async function fetchAnnouncements() {
    try {
      const res = await fetch("/svatba/dnes/api/data");
      if (!res.ok) return;
      const data = await res.json();
      
      const container = document.getElementById("live-announcement-container");
      const textEl = document.getElementById("announcement-text");
      const timeEl = document.getElementById("announcement-time");

      if (!container || !textEl || !timeEl) return;

      const announcements = data.announcements || [];
      if (announcements.length > 0) {
        const latest = announcements[0];
        textEl.textContent = latest.text;

        if (latest.timestamp) {
          const dt = new Date(latest.timestamp);
          timeEl.textContent = dt.toLocaleTimeString("cs-CZ", { hour: "2-digit", minute: "2-digit" });
        } else {
          timeEl.textContent = "";
        }

        container.classList.remove("hidden");

        if (lastSeenId && lastSeenId !== latest.id) {
          // Play slide/pulse animation for new message
          container.firstElementChild?.classList.add("animate-bounce");
          setTimeout(() => {
            container.firstElementChild?.classList.remove("animate-bounce");
          }, 1500);
        }
        lastSeenId = latest.id;
      } else {
        container.classList.add("hidden");
      }
    } catch (e) {
      console.warn("Polling error:", e);
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    fetchAnnouncements();
    setInterval(fetchAnnouncements, 30000);
  });
</script>
