---
// src/components/wedding-day/InfoTab.astro
import TransitDepartures from "./TransitDepartures.astro";
import { getEntry } from "astro:content";

const wedding = await getEntry("wedding", "info");
const whenWhere = wedding?.data.whenWhere;
---

<div class="space-y-6">
  <div class="text-center">
    <div
      class="bg-wedding-dark/10 text-wedding-dark dark:bg-wedding-light/10 mb-2 inline-flex h-12 w-12 items-center justify-center rounded-2xl text-2xl"
    >
      ℹ️
    </div>
    <h2
      class="text-wedding-dark flex items-center justify-center gap-3 text-2xl font-bold tracking-tight"
    >
      <span
        class="morse-decoder text-wedding-medium cursor-help text-lg tracking-tighter opacity-30 transition-opacity hover:opacity-100"
        data-decoded="I">··</span
      >
      <span>Informace</span>
      <span
        class="morse-decoder text-wedding-medium cursor-help text-lg tracking-tighter opacity-30 transition-opacity hover:opacity-100"
        data-decoded="E">·</span
      >
    </h2>
    <p
      class="text-wedding-medium mx-auto mt-1 max-w-sm text-xs leading-relaxed"
    >
      Tady najdete informace o parkování a odjezdech MHD zpět do Brna.
    </p>
  </div>

  <!-- Venue & Map Card -->
  <div
    class="morse-border bg-wedding-light/90 dark:bg-wedding-dark/80 border-wedding-medium/20 rounded-2xl border p-5 shadow-sm"
  >
    <div class="mb-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span
          class="bg-wedding-dark/10 dark:bg-wedding-light/10 text-wedding-dark flex h-10 w-10 items-center justify-center rounded-xl font-bold"
        >
          📍
        </span>
        <div>
          <h3 class="text-wedding-dark text-base font-bold">
            {whenWhere?.venueName || "Sokec, Šlapanice"}
          </h3>
          <p class="text-wedding-medium text-xs">
            {whenWhere?.address || "Nádražní 87, 664 51 Šlapanice"}
          </p>
        </div>
      </div>
    </div>

    <a
      href={whenWhere?.googleMapsUrl ||
        "https://maps.app.goo.gl/AJ5MkMekiaeEhSGf6"}
      target="_blank"
      rel="noopener noreferrer"
      class="morse-border text-wedding-dark border-wedding-dark/40 hover:bg-wedding-dark hover:text-wedding-light inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-xl border p-3 text-xs font-bold tracking-wider uppercase transition-all duration-300 hover:scale-105 active:scale-95"
    >
      <span>🗺️</span> Otevřít v Google Mapách
    </a>
  </div>

  <!-- Parking Warning -->
  <div
    class="rounded-2xl border border-amber-500/30 bg-amber-500/10 p-4 text-xs leading-relaxed text-amber-900 dark:text-amber-200"
  >
    <span class="font-bold">⚠️ Důležité upozornění k parkování:</span>
    <p class="mt-1">
      Parkování je možné přímo u Sokecu nebo v okolních ulicích. Jen pozor:
      pokud zaparkujete v ulici Nádražní a auto tam necháte do neděle, je
      potřeba odjet nejpozději do 13:00. Poté zde kvůli průvodu Šlapanických
      slavností platí zákaz zastavení.
    </p>
  </div>

  <!-- Transit Departures Widget -->
  <TransitDepartures />
</div>
